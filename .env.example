# ---------------------------------------------------------------------------
# Gymlarper environment
#
#   cp .env.example .env
#
# Generate DJANGO_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Core --------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
DJANGO_PUBLIC_ORIGIN=http://localhost:8000
DJANGO_TIME_ZONE=UTC

# --- Database ----------------------------------------------------------------
POSTGRES_DB=gymlarper
POSTGRES_USER=gymlarper
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Google OAuth2 -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> Credentials -> Create
# credentials -> OAuth client ID.
#
# The same server accepts the Web, Android and iOS client IDs, comma separated.
# google-auth only allows ONE audience per verify call, so mobile apps should
# send the *Web* client ID via `serverClientId` - that is the single ID shared
# across platforms for a Google Sign-In that also works in a browser.
GOOGLE_CLIENT_IDS=
# Optional: restrict sign-in to one Workspace domain, e.g. mycompany.com
GOOGLE_HD_ORG_DOMAIN=

# --- Tokens ------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Server ------------------------------------------------------------------
LOG_LEVEL=INFO
# Address the API port is published on. Keep 127.0.0.1 when using the proxy.
API_BIND=127.0.0.1

# --- Reverse proxy (docker compose --profile prod) ---------------------------
# A real domain enables automatic HTTPS; ":80" serves plain HTTP for testing.
SITE_ADDRESS=:80
# Directory holding the Flutter web build, mounted into the proxy.
WEB_ROOT=

# --- Optional ----------------------------------------------------------------
# Create the Django superuser on first boot (DJANGO_ADMIN_USERNAME/PASSWORD).
CREATE_SUPERUSER=false
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=
# Force HTTPS redirects. Auto-disabled when DJANGO_DEBUG=true.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000