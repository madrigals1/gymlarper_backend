# Python / Django / pipenv
__pycache__/
*.py[cod]
*.egg-info/
# pipenv: PIPENV_VENV_IN_PROJECT=1 puts the venv in the project; the default
# lives under ~/.local/share/virtualenvs/ but ignore it here too.
.venv/
venv/
.python-version
Pipfile.lock.bak
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Django
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
*.log

# Environment - never commit these
.env
.env.local
.env.*.local
!.env.example

# Editors / OS
# .vscode/ IS tracked on purpose: extensions.json + settings.json pin the
# formatters so every editor agrees with `pipenv run format`.
.idea/
.DS_Store
*.swp
