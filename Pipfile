[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[packages]
# Constraints express intent; Pipfile.lock pins the exact resolved versions
# that Docker installs. Keep framework pins inside their minor series - a
# Django or DRF major bump can break unrelated code without warning.
django = "~=6.1.2"
djangorestframework = "~=3.18.3"
djangorestframework-simplejwt = "~=5.5.1"
django-cors-headers = "~=4.9.0"
django-filter = "~=26.2"
psycopg = {version = "~=3.3.6", extras = ["binary"]}
google-auth = "~=2.61.0"
python-dotenv = "~=1.1.1"
gunicorn = "~=23.0.0"
whitenoise = "~=6.12.0"

[requires]
python_version = "3.14"

[dev-packages]
# Formatting and import ordering. Config lives in pyproject.toml.
# Installed with `pipenv install --dev`; Docker never needs these because it
# installs from Pipfile.lock with `--deploy` (runtime packages only).
black = "~=26.1.0"
isort = "~=7.0.0"

[scripts]
# Run these with `pipenv run <name>`. They execute inside .venv.
test = "python manage.py test --settings=config.test_settings"
lint = "sh -c 'black --check --diff . && isort --check-only --diff .'"
format = "sh -c 'isort . && black .'"