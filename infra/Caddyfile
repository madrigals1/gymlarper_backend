# Reverse proxy for production.
#
# Terminates TLS, forwards /api/* to Django, and optionally serves the Flutter
# web build from WEB_ROOT. Set SITE_ADDRESS to a real domain to get
# automatic HTTPS from Caddy.

{
	admin off
	auto_https off
}

:{$SITE_ADDRESS:80} {
	encode gzip zstd

	handle /healthz {
		reverse_proxy {$UPSTREAM_API:api:8000}
	}

	handle /api/* {
		reverse_proxy {$UPSTREAM_API:api:8000}
	}

	handle {
		root * {$WEB_ROOT:/srv/web}
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}